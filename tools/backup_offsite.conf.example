# Copie para /home/deploy/backup_offsite.conf na VPS de produção e ajuste.
# chmod 600 /home/deploy/backup_offsite.conf && chown deploy:deploy ...

# IP ou hostname da VPS de contenção (Oracle)
CONTENCAO_HOST=163.176.26.255

# Usuário SSH na contenção (mesmo do CRM)
CONTENCAO_USER=deploy

# Chave privada só para backup (gerada na produção)
CONTENCAO_SSH_KEY=/home/deploy/.ssh/id_ed25519_offsite

# Porta SSH
CONTENCAO_SSH_PORT=22

# Slug da instalação (mesmo de VARIAVEIS_INSTALACAO /empresa)
# Se vazio, o script tenta ler de VARIAVEIS_INSTALACAO
EMPRESA=

# Dias de retenção no lado da produção (pasta local temporária). A retenção do cofre fica na contenção.
KEEP_LOCAL_DAYS=1
